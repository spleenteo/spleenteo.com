---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ListHeader from '../components/ListHeader.astro';
import ContraptionRow from '../components/ContraptionRow.astro';
import { contraptions } from '../data/site';
import MadeForMe from '../components/MadeForMe.astro';
import Slot from '../components/Slot.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Nav />
  <main>
    <Hero />
    <section id="contraptions" class="contraptions">
      <ListHeader />
      <div class="rows">
        {contraptions.map((item, i) => <ContraptionRow item={item} side={i % 2 === 0 ? 'left' : 'right'} />)}
      </div>
    </section>
    <MadeForMe />
    <Slot />
    <About />
  </main>
  <Footer />
</Base>

<style>
  .contraptions {
    padding: 24px 0 80px;
    --k: 1px;
  }
  .rows {
    display: flex;
    flex-direction: column;
    gap: 72px;
    margin-top: 72px;
  }
  @media (min-width: 960px) {
    .contraptions {
      /* 1px at 1440, 1.6px at 2560: past 1440 the panels keep bleeding
         off the edges and grow slower than the viewport. */
      --k: min(100vw / 1440, 0.2286px + 0.05357vw);
      /* Product icons stay small against the panels: 120px at 1440,
         shrinking to 100px at 2560 while the panels keep growing. */
      --mark: min(120 * var(--k), clamp(100px, 145.71px - 1.7857vw, 120px));
      padding: clamp(40px, 1.7857vw + 14.29px, 60px) 0 calc(160 * var(--k));
    }
    .rows {
      gap: calc(140 * var(--k));
      margin-top: calc(140 * var(--k));
    }
  }
</style>
