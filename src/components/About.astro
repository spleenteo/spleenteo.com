---
import { about } from '../data/site';

const [before, after] = about.text.split(about.link.word, 2) as [string, string];
---

<section id="about" class="about">
  <h2 class="mono-label kicker">{about.kicker}</h2>
  <div class="body">
    <p class="text">
      {before}<a class="text-link" href={about.link.href}>{about.link.word}</a>{after}
    </p>
    <ul class="contacts">
      {about.contacts.map((c) => (
        <li><a href={c.href}>{c.label}</a></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 72px var(--gutter);
    background: var(--bg-raised);
  }
  .kicker {
    font-weight: 400;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .text {
    font-family: var(--font-body);
    color: var(--ink);
    font-size: 20px;
    line-height: 1.45;
    max-width: 820px;
  }
  .text-link {
    font-weight: 700;
    color: var(--acc-dato);
  }
  .contacts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .contacts a {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.5px;
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  @media (min-width: 960px) {
    .about {
      flex-direction: row;
      gap: clamp(96px, 3.9286vw + 39.43px, 140px);
      padding: clamp(120px, 3.5714vw + 68.57px, 160px) var(--gutter);
    }
    .kicker {
      width: clamp(260px, 8.9286vw + 131.43px, 360px);
      flex: none;
    }
    .text {
      font-size: clamp(26px, 1.0714vw + 10.57px, 38px);
      max-width: clamp(820px, 33.9286vw + 331.43px, 1200px);
    }
    .contacts {
      flex-direction: row;
      gap: 40px;
    }
    .contacts a {
      font-size: clamp(15px, 0.2679vw + 11.14px, 18px);
    }
  }
</style>
