---
import Panel from './Panel.astro';
import type { Contraption } from '../data/site';

interface Props {
  item: Contraption;
  side: 'left' | 'right';
}

const { item, side } = Astro.props;
---

<article class:list={['row', `row-${side}`]} style={`--accent: var(--acc-${item.accent})`}>
  <Panel index={item.index} accent={item.accent} mark={item.mark} name={item.name} side={side} />
  <div class="text">
    <p class="kind">{item.kind}</p>
    <h3 class="name">{item.name}</h3>
    <p class="one-liner">{item.oneLiner}</p>
    <p class="why">{item.why}</p>
    <div class="meta-row">
      <p class="meta">{item.meta}</p>
      <p class="links">
        <a href={item.href}>{item.linkLabel}</a>
        {item.repo && <a href={item.repo}>repo →</a>}
      </p>
    </div>
  </div>
</article>

<style>
  .row {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 0 var(--gutter);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .kind,
  .meta,
  .links {
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .kind {
    letter-spacing: 0.5px;
    color: var(--accent);
  }
  .name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 40px;
    letter-spacing: -1px;
    line-height: 1;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .one-liner {
    font-size: 19px;
    line-height: 1.35;
    color: var(--ink);
  }
  .why {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-dim);
  }
  .meta-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid var(--line);
    padding-top: 18px;
  }
  .meta {
    color: var(--ink-dim);
    overflow-wrap: anywhere;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    color: var(--accent);
  }
  .links a {
    overflow-wrap: anywhere;
  }
  @media (min-width: 960px) {
    .row {
      display: block;
      position: relative;
      padding: 0;
      height: calc(660 * var(--k));
    }
    .text {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      gap: 22px;
      /* Distance of the text from the panel's edge of the viewport, and its
         width: 811/565 at 1440, 1250/900 at 2560. Mirrored on right rows. */
      --text-at: min(56.319vw, 39.1964vw + 246.57px);
      width: min(max(565px, 29.9107vw + 134.29px), 100vw - var(--text-at) - 64px);
    }
    .row-left .text {
      left: var(--text-at);
    }
    .row-right .text {
      right: var(--text-at);
    }
    .kind {
      font-size: clamp(13px, 0.5357vw + 5.29px, 19px);
    }
    .meta,
    .links {
      font-size: var(--mono-size);
    }
    .name {
      font-size: clamp(64px, 2.8571vw + 22.86px, 96px);
      letter-spacing: -0.031em;
    }
    .one-liner {
      font-size: clamp(24px, 0.8929vw + 11.14px, 34px);
    }
    .why {
      font-size: clamp(17px, 0.3571vw + 11.86px, 21px);
    }
    .meta-row {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 8px 24px;
      padding-top: 24px;
    }
    .links {
      justify-content: flex-end;
      text-align: right;
    }
  }
</style>
