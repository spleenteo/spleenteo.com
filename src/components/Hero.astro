---
import { hero } from '../data/site';
const accents = ['quadra', 'maestro', 'devflow', 'datobar', 'condates'];
---

<section class="hero">
  <p class="mono-label">{hero.kicker}</p>
  <h1>{hero.title}</h1>
  <div class="row">
    <p class="lede">{hero.lede}</p>
    <div class="strip" aria-hidden="true">
      {accents.map((a) => <span style={`background: var(--acc-${a})`}></span>)}
    </div>
  </div>
  <p class="mono-label">{hero.byline}</p>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 56px var(--gutter) 72px;
  }
  h1 {
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--ink);
    line-height: 0.9;
    letter-spacing: -0.033em;
    font-size: clamp(44px, 14vw, 64px);
  }
  .row {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .lede {
    max-width: 620px;
    color: var(--ink);
    font-size: 20px;
    line-height: 1.35;
  }
  .strip {
    display: flex;
    gap: 8px;
  }
  .strip span {
    width: 32px;
    height: 8px;
  }
  @media (min-width: 960px) {
    .hero {
      gap: clamp(40px, 1.4286vw + 19.43px, 56px);
      padding: clamp(120px, 5.3571vw + 42.86px, 180px) var(--gutter) clamp(140px, 5.3571vw + 62.86px, 200px);
    }
    h1 {
      font-size: clamp(64px, 12.8vw, 330px);
    }
    .row {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
    .lede {
      font-size: clamp(28px, 1.0714vw + 12.57px, 40px);
      max-width: clamp(620px, 25vw + 260px, 900px);
    }
    .strip {
      gap: clamp(10px, 0.3571vw + 4.86px, 14px);
    }
    .strip span {
      width: clamp(44px, 1.7857vw + 18.29px, 64px);
      height: clamp(10px, 0.3571vw + 4.86px, 14px);
    }
  }
</style>
