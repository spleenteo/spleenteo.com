---
import { footer } from '../data/site';
---

<footer class="footer">
  <p class="mono-label">{footer.left}</p>
  <p class="mono-label">{footer.right}</p>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 28px var(--gutter);
  }
  @media (min-width: 960px) {
    .footer {
      flex-direction: row;
      justify-content: space-between;
      padding: 32px var(--gutter);
    }
  }
</style>
