---
import { Image } from 'astro:assets';
import quadra from '../../design/assets/quadra-icon.png';
import maestro from '../../design/assets/maestro-icon-1024.png';
import datobar from '../../design/assets/dato-dev-bar.png';
import type { Accent, Mark } from '../data/site';

interface Props {
  index: string;
  accent: Accent;
  mark?: Mark;
  name: string;
  side: 'left' | 'right';
}

const { index, accent, mark, name, side } = Astro.props;
const marks = { quadra, maestro, datobar };
---

<div class:list={['panel', `panel-${side}`, mark && `mark-${mark}`]} style={`--accent: var(--acc-${accent})`}>
  <span class="index" aria-hidden="true">{index}</span>
  {
    mark && (
      <Image
        class="mark"
        src={marks[mark]}
        alt={`${name} icon`}
        width={240}
        densities={[1, 2]}
      />
    )
  }
</div>

<style>
  .panel {
    position: relative;
    width: 100%;
    height: 220px;
    background: var(--accent);
    overflow: hidden;
  }
  .index {
    position: absolute;
    left: 20px;
    top: -18px;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: min(140px, 36vw);
    letter-spacing: -6px;
    line-height: 1;
    color: var(--on-accent);
  }
  .mark {
    position: absolute;
    right: 22px;
    bottom: 22px;
    width: min(56px, 14vw);
    height: min(56px, 14vw);
    border-radius: 13px;
    box-shadow: 0 10px 25px #00000055;
  }
  /* This icon carries its own rounded shape inside a transparent margin,
     so the shadow follows the artwork instead of the box. */
  .mark-datobar .mark {
    border-radius: 0;
    box-shadow: none;
    filter: drop-shadow(0 10px 25px #00000055);
  }
  @media (min-width: 960px) {
    .panel {
      position: absolute;
      top: calc(80 * var(--k));
      width: calc(780 * var(--k));
      height: calc(500 * var(--k));
    }
    .panel-left {
      left: calc(-102.5 * var(--k));
      transform: rotate(-10deg);
    }
    .panel-right {
      right: calc(-102.5 * var(--k));
      transform: rotate(10deg);
    }
    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        .panel-left,
        .panel-right {
          transform: none;
          /* Longhands on purpose: the minifier folds a shorthand plus
             animation-timeline into `animation: … view()`, which Chrome drops. */
          animation-name: tilt;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: view();
        }
      }
    }
    .index {
      top: calc(-40 * var(--k));
      font-size: calc(300 * var(--k));
      letter-spacing: -0.047em;
    }
    .panel-left .index {
      left: calc(190 * var(--k));
    }
    .panel-right .index {
      left: calc(300 * var(--k));
    }
    /* Marks sit in the panel's bottom corner on the text side: bottom-right
       on left panels, bottom-left on right panels. */
    .mark {
      right: auto;
      bottom: calc(56 * var(--k));
      width: var(--mark);
      height: var(--mark);
      border-radius: calc(var(--mark) * 0.225);
    }
    .panel-left .mark {
      left: auto;
      right: calc(56 * var(--k));
    }
    .panel-right .mark {
      left: calc(56 * var(--k));
    }
  }
  @keyframes tilt {
    from {
      transform: rotate(-10deg);
    }
    to {
      transform: rotate(10deg);
    }
  }
</style>
